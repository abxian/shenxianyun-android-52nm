<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="#CFFFFFFF" /><corners android:radius="18dp" />
            <stroke android:width="2dp" android:color="@color/sxy_purple" /></shape>
    </item>
    <item><shape><gradient android:angle="315" android:startColor="#BFFFFFFF" android:endColor="#99EAF0FF" />
        <corners android:radius="18dp" /><stroke android:width="1dp" android:color="#B3B8C4F3" /></shape></item>
</selector>
