+
+// billableProxy uses the concrete leaf recorded by the completed dial, not the
+// rule or current selector, which may already have changed. Provider identity
+// disambiguates equal proxy names. Unknown leaves are excluded, never totalled.
+func billableProxy(chain C.Chain, providerChain C.Chain) bool {
+	if len(chain) == 0 {
+		return false
+	}
+	configMux.RLock()
+	defer configMux.RUnlock()
+	name := chain[0]
+	providerName := ""
+	if len(providerChain) > 0 {
+		providerName = providerChain[0]
+	}
+	var leaf C.Proxy
+	if providerName != "" {
+		if provider, ok := providers[providerName]; ok {
+			for _, p := range provider.Proxies() {
+				if p.Name() == name {
+					leaf = p
+					break
+				}
+			}
+		}
+	} else {
+		leaf = proxies[name]
+	}
+	return leaf != nil && leaf.Type() >= C.Shadowsocks
+}
