diff --git a/tunnel/statistic/proxy_accounting_test.go b/tunnel/statistic/proxy_accounting_test.go
new file mode 100644
index 0000000..c665bec
--- /dev/null
+++ b/tunnel/statistic/proxy_accounting_test.go
@@ -0,0 +1,43 @@
+package statistic
+
+import (
+	C "github.com/metacubex/mihomo/constant"
+	"testing"
+)
+
+// Closed/short connections are counted on IO, not by sampling live trackers.
+func TestProxyAccountingTotals(t *testing.T) {
+	m := DefaultManager
+	m.ResetStatistic()
+	m.PushUploaded(10)
+	m.PushDownloaded(20) // direct
+	m.PushUploaded(30, true)
+	m.PushDownloaded(40, true)
+	s := m.Snapshot()
+	if s.UploadTotal != 40 || s.DownloadTotal != 60 || s.ProxyUploadTotal != 30 || s.ProxyDownloadTotal != 40 {
+		t.Fatal(s)
+	}
+	m.ResetStatistic()
+	s = m.Snapshot()
+	if s.ProxyUploadTotal != 0 || s.ProxyDownloadTotal != 0 {
+		t.Fatal("reset")
+	}
+}
+func TestProxyAccountingClosedAndInternal(t *testing.T) {
+	m := DefaultManager
+	m.ResetStatistic()
+	// Exercise initial peek + writer callback (the splice/copy fast path).
+	tracker := &tcpTracker{manager: m, pushToManager: true, proxyTraffic: true, TrackerInfo: &TrackerInfo{}}
+	_, writers := tracker.UnwrapWriter()
+	writers[0](123)
+	tracker.proxyTraffic = false
+	writers[0](77)
+	tracker.pushToManager = false
+	tracker.proxyTraffic = true
+	writers[0](999) // inner dialer excluded
+	s := m.Snapshot()
+	if s.ProxyUploadTotal != 123 || s.UploadTotal != 200 {
+		t.Fatal(s)
+	}
+	_ = C.Direct
+}
