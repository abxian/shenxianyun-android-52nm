+++ b/tunnel/proxy_accounting_test.go
@@ -0,0 +1,27 @@
+package tunnel
+
+import (
+	C "github.com/metacubex/mihomo/constant"
+	"testing"
+)
+
+type accountingProxy struct {
+	C.Proxy
+	tp C.AdapterType
+}
+
+func (p accountingProxy) Type() C.AdapterType { return p.tp }
+func TestProxyAccountingConcreteLeaf(t *testing.T) {
+	old := proxies
+	defer func() { proxies = old }()
+	proxies = map[string]C.Proxy{"alias-direct": accountingProxy{tp: C.Direct}, "ss": accountingProxy{tp: C.Shadowsocks}, "reject": accountingProxy{tp: C.Reject}}
+	if billableProxy(C.Chain{"alias-direct", "代理选择"}, nil) {
+		t.Fatal("direct alias billed")
+	}
+	if billableProxy(C.Chain{"missing"}, nil) || billableProxy(nil, nil) || billableProxy(C.Chain{"reject"}, nil) {
+		t.Fatal("unknown/reject billed")
+	}
+	if !billableProxy(C.Chain{"ss", "中转DIRECT", "选择"}, nil) {
+		t.Fatal("proxy through direct transport must count once")
+	}
+}
